# LegalUpdate AI Environment Configuration

# Server
PORT=5000
DEBUG=True
ENVIRONMENT=development
SECRET_KEY=legalupdate-ai-secret-key-production-2026
JWT_SECRET=legalupdate-jwt-secret-production-2026

# Firebase Configuration (Firestore & Authentication)
# Path to your downloaded serviceAccountKey.json from Firebase Console
FIREBASE_SERVICE_ACCOUNT_KEY=./firebase-service-account.json
FIREBASE_PROJECT_ID=legalupdate-ai

# Groq API Configuration
# Get your API key from https://console.groq.com/keys
GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=llama-3.3-70b-versatile

# Firecrawl API Configuration
# Get your API key from https://firecrawl.dev
FIRECRAWL_API_KEY=your_firecrawl_api_key_here
FIRECRAWL_API_URL=https://api.firecrawl.dev/v1

# Memento Historical Memory Configuration
MEMENTO_API_KEY=your_memento_api_key_if_hosted
MEMENTO_STORAGE_PATH=./data/memento_store
